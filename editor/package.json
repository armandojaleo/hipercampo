{
  "name": "hipercampo-viewer",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.9.0",
  "publisher": "armandojaleo",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/armandojaleo/hipercampo" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Visualization"],
  "keywords": ["hipercampo", "memory", "mcp", "claude"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hipercampo.showMemories",
        "title": "%cmd.showMemories%",
        "icon": "$(database)"
      },
      {
        "command": "hipercampo.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hipercampoView",
          "title": "hipercampo",
          "icon": "media/brain.svg"
        }
      ]
    },
    "views": {
      "hipercampoView": [
        {
          "id": "hipercampo.home",
          "name": "%view.home%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hipercampo.showMemories",
          "when": "view == hipercampo.home",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "hipercampo",
      "properties": {
        "hipercampo.command": {
          "type": "string",
          "default": "hipercampo",
          "description": "%config.command%"
        },
        "hipercampo.dbPath": {
          "type": "string",
          "default": "",
          "description": "%config.dbPath%"
        },
        "hipercampo.namespace": {
          "type": "string",
          "default": "",
          "description": "%config.namespace%"
        },
        "hipercampo.allNamespaces": {
          "type": "boolean",
          "default": true,
          "description": "%config.allNamespaces%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
