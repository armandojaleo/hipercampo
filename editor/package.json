{
  "name": "hipercampo-viewer",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.9.21",
  "preview": true,
  "publisher": "armandojaleo",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#080d3a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/armandojaleo/hipercampo"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces the hipercampo executable path and database path are ignored (they can run code / read arbitrary files); the viewer uses only your user settings.",
      "restrictedConfigurations": [
        "hipercampo.command",
        "hipercampo.dbPath"
      ]
    }
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "hipercampo",
    "memory",
    "mcp",
    "claude",
    "codex",
    "ai-agents"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hipercampo.showMemories",
        "title": "%cmd.showMemories%",
        "icon": "$(database)"
      },
      {
        "command": "hipercampo.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "hipercampo.editLinked",
        "title": "%cmd.editLinked%",
        "icon": "$(link)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hipercampoView",
          "title": "Hipercampo",
          "icon": "media/brain.svg"
        }
      ]
    },
    "views": {
      "hipercampoView": [
        {
          "id": "hipercampo.home",
          "name": "%view.home%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hipercampo.showMemories",
          "when": "view == hipercampo.home",
          "group": "navigation"
        },
        {
          "command": "hipercampo.editLinked",
          "when": "view == hipercampo.home",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Hipercampo",
      "properties": {
        "hipercampo.command": {
          "type": "string",
          "default": "hipercampo",
          "description": "%config.command%"
        },
        "hipercampo.dbPath": {
          "type": "string",
          "default": "",
          "description": "%config.dbPath%"
        },
        "hipercampo.namespace": {
          "type": "string",
          "default": "",
          "description": "%config.namespace%"
        },
        "hipercampo.allNamespaces": {
          "type": "boolean",
          "default": true,
          "description": "%config.allNamespaces%"
        },
        "hipercampo.linked": {
          "type": "string",
          "default": "",
          "description": "%config.linked%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node tests/i18n.test.js && node tests/extension.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "preview": "node tools/preview.js --all",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm test",
    "coverage": "node tools/run-coverage.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
